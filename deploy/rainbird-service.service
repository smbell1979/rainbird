[Unit]
Description=Rain Bird cycle-and-soak service (API on 127.0.0.1:8710)
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=%h/rainbird/service
EnvironmentFile=%h/rainbird/rainbird.env
ExecStart=%h/rainbird/venv/bin/python -m rbservice
# On stop, the service cancels any run, which sends stop to the controller.
TimeoutStopSec=90
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
