[Unit]
Description=Rain Bird sprinkler page (port 3004)
After=rainbird-service.service

[Service]
WorkingDirectory=%h/rainbird/web
Environment=RAINBIRD_API=http://127.0.0.1:8710
Environment=NODE_ENV=production
# Scott's NUC services run on 3000-3003 and up, so this one is 3004.
ExecStart=/usr/bin/npm run start -- -p 3004 -H 0.0.0.0
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
